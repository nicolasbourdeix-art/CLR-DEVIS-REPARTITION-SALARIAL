  .card-title{background:#eff6ff;border-bottom:2px solid #2563eb;padding:12px 20px;font-weight:700;color:#1e40af;font-size:14px;}
  .upload-zone{padding:30px 20px;text-align:center;border:2px dashed #d1d5db;margin:20px;border-radius:10px;cursor:pointer;transition:border .2s,background .2s;}
