function getLogoRuminantesB64() {
  try {
    const files = DriveApp.getFilesByName("LOGO_fond_blanc.jpg");
    if (files.hasNext()) {
      const b64 = Utilities.base64Encode(files.next().getBlob().getBytes());
      return "data:image/jpeg;base64," + b64;
    }
  } catch (e) {
    Logger.log("⚠️ Logo Drive introuvable : " + e.message);
  }
  return "";
}

