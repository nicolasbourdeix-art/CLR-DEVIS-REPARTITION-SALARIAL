  .upload-zone input{display:none;}
  .upload-icon{font-size:40px;margin-bottom:10px;}
  .upload-text{color:#6b7280;font-size:14px;}
  .upload-text strong{color:#1e40af;}
  .btn-main{display:block;width:calc(100% - 40px);margin:0 20px 20px;padding:14px;background:#1e40af;color:#fff;font-size:15px;font-weight:700;border:none;border-radius:10px;cursor:pointer;transition:background .2s;}
  .btn-main:hover{background:#1d4ed8;}
  .btn-main:disabled{background:#9ca3af;cursor:not-allowed;}
  .btn-submit{display:block;width:100%;padding:15px;background:#16a34a;color:#fff;font-size:16px;font-weight:700;border:none;border-radius:10px;cursor:pointer;margin-top:8px;}
  .btn-submit:hover{background:#15803d;}
  .btn-submit:disabled{background:#9ca3af;cursor:not-allowed;}
  .progress{display:none;padding:16px 20px;}
  .progress-bar-bg{background:#e5e7eb;border-radius:99px;height:8px;overflow:hidden;margin-top:8px;}
  .progress-bar{height:8px;border-radius:99px;background:#2563eb;width:0%;transition:width .4s;}
  .progress-text{font-size:13px;color:#6b7280;margin-bottom:6px;}
  .form-section{display:none;padding:20px;}
  .form-group{margin-bottom:16px;}
  .form-group label{display:block;font-weight:600;color:#374151;margin-bottom:5px;font-size:14px;}
  .req{color:#ef4444;margin-left:3px;}
  .form-group input,.form-group select{width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:8px;font-size:14px;}
  .form-group input:focus,.form-group select:focus{outline:none;border-color:#2563eb;}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  @media(max-width:500px){.form-row{grid-template-columns:1fr;}}
  .section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#9ca3af;margin:20px 0 12px;padding-top:16px;border-top:1px solid #f3f4f6;}
  .file-name{margin-top:10px;font-size:13px;color:#2563eb;font-weight:600;display:none;}
  .success{display:none;text-align:center;padding:60px 20px;}
  .success h2{color:#166534;font-size:22px;margin-bottom:12px;}
  .success p{color:#6b7280;font-size:15px;line-height:1.6;}
</style>
</head>
<body>

<div class="header-top">
  <img src="${logoAmiis}" alt="AMIIS" style="height:55px;object-fit:contain;"/>
</div>
<div class="header">
  <h1>Nouveau devis / contrat</h1>
  <p>Uploadez le PDF du devis — les informations seront extraites automatiquement</p>
</div>

<div class="container" id="mainZone">

  <div class="card" id="stepUpload">
    <div class="card-title">① Uploader le PDF du devis organisateur</div>
    <div class="upload-zone" id="dropZone" onclick="document.getElementById('pdfInput').click()">
      <input type="file" id="pdfInput" accept=".pdf" onchange="onFileSelected(this)"/>
      <div class="upload-icon">📄</div>
      <div class="upload-text">
        <strong>Cliquez pour sélectionner</strong> ou glissez-déposez le PDF
      </div>
      <div class="file-name" id="fileName"></div>
    </div>
    <button class="btn-main" id="btnExtract" onclick="extraireInfos()" disabled>
      Extraire les informations automatiquement
    </button>
    <div class="progress" id="progressZone">
      <div class="progress-text" id="progressText">Lecture du PDF en cours...</div>
      <div class="progress-bar-bg"><div class="progress-bar" id="progressBar"></div></div>
    </div>
  </div>

  <div class="card" id="stepForm" style="display:none;">
    <div class="card-title">② Vérifier et compléter les informations</div>
    <div class="form-section" id="formSection">

      <div class="section-title">🏢 Organisateur</div>
      <div class="form-group">
        <label>Raison sociale <span class="req">*</span></label>
        <input type="text" id="f_raisonSociale" placeholder="Nom de la structure"/>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Forme juridique</label><input type="text" id="f_formeJuridique" placeholder="Association, SARL..."/></div>
        <div class="form-group"><label>SIRET</label><input type="text" id="f_siret" placeholder="12345678900012"/></div>
      </div>
      <div class="form-group"><label>Adresse</label><input type="text" id="f_adresse" placeholder="N° et nom de rue"/></div>
      <div class="form-row">
        <div class="form-group"><label>Code postal</label><input type="text" id="f_codePostal" placeholder="40000"/></div>
        <div class="form-group"><label>Ville</label><input type="text" id="f_ville" placeholder="Mont-de-Marsan"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Téléphone</label><input type="text" id="f_telephone" placeholder="06 00 00 00 00"/></div>
        <div class="form-group"><label>Email organisateur</label><input type="email" id="f_emailOrga" placeholder="contact@structure.fr"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Signataire</label><input type="text" id="f_signataire" placeholder="Prénom Nom"/></div>
        <div class="form-group"><label>Qualité</label><input type="text" id="f_qualite" placeholder="Directeur, Président..."/></div>
      </div>

      <div class="section-title">🎭 Projet</div>
      <div class="form-group">
        <label>Nom du projet <span class="req">*</span></label>
        <input type="text" id="f_nomProjet"/>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Date de début</label><input type="date" id="f_dateDebut"/></div>
        <div class="form-group"><label>Date de fin</label><input type="date" id="f_dateFin"/></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Type</label>
          <select id="f_typeSpectacle">
            <option value="">-- choisir --</option>
            <option value="Spectacle">Spectacle</option>
            <option value="Médiation">Médiation</option>
            <option value="Spectacle + Médiation">Spectacle + Médiation</option>
          </select>
        </div>
        <div class="form-group"><label>Nombre de représentations</label><input type="number" id="f_nbRepresen" min="0" placeholder="1"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Nombre d'heures facturées</label><input type="number" id="f_heures" min="0" step="0.5" placeholder="0"/></div>
        <div class="form-group"><label>Tarif horaire (€)</label><input type="number" id="f_tarifHeure" min="0" step="0.01" placeholder="0"/></div>
      </div>

      <div class="section-title">💰 Montants</div>
      <div class="form-row">
        <div class="form-group"><label>Prix de cession (€)</label><input type="number" id="f_prixCession" min="0" step="0.01" placeholder="0"/></div>
        <div class="form-group"><label>Frais hébergement (€)</label><input type="number" id="f_fraisHeberg" min="0" step="0.01" placeholder="0"/></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Frais restauration (€)</label><input type="number" id="f_fraisResto" min="0" step="0.01" placeholder="0"/></div>
        <div class="form-group"><label>Frais déplacement (€)</label><input type="number" id="f_fraisDeplac" min="0" step="0.01" placeholder="0"/></div>
      </div>
      <div class="form-group"><label>Frais médiation / petit matériel (€)</label><input type="number" id="f_fraisMediation" min="0" step="0.01" placeholder="0"/></div>

      <div class="section-title">📝 Contrat</div>
      <div class="form-group">
        <label>Rédiger un contrat de cession ?</label>
        <select id="f_rediger"><option value="Non">Non</option><option value="Oui">Oui</option></select>
      </div>

      <!-- Clé Drive du PDF — ne pas modifier -->
      <input type="hidden" id="hiddenTempKey" value=""/>

      <button class="btn-submit" id="btnSubmit" onclick="soumettre()" disabled>⏳ En attente du PDF...</button>
    </div>
  </div>
</div>

<div class="success" id="successZone">
  <h2>✅ Devis créé avec succès !</h2>
  <p>Les informations ont été enregistrées.<br/>Le récap DPAE a été généré et envoyé au porteur.</p>
</div>

<script>
// ── champ caché qui stocke la clé Drive du PDF ──────────────
// On l'écrit dans un input hidden pour être sûr qu'il
// est sérialisé correctement dans le payload JSON.
function getTempPdfKey()  { return document.getElementById("hiddenTempKey").value; }
function setTempPdfKey(k) { document.getElementById("hiddenTempKey").value = k; }

// Drag & drop
const dropZone = document.getElementById("dropZone");
dropZone.addEventListener("dragover", e => { e.preventDefault(); dropZone.classList.add("dragover"); });
dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragover"));
dropZone.addEventListener("drop", e => {
  e.preventDefault(); dropZone.classList.remove("dragover");
  const f = e.dataTransfer.files[0];
  if (f && f.type === "application/pdf") processFile(f);
});

function onFileSelected(input) { if (input.files[0]) processFile(input.files[0]); }

function processFile(file) {
  document.getElementById("fileName").textContent = "📎 " + file.name;
  document.getElementById("fileName").style.display = "block";
  // Bloquer le bouton Valider tant que le PDF n'est pas stocké
  document.getElementById("btnSubmit").disabled = true;
  document.getElementById("btnSubmit").textContent = "⏳ Stockage du PDF en cours...";

  const reader = new FileReader();
  reader.onload = e => {
    const base64 = e.target.result.split(",")[1];

    // Étape 1 : stocker le PDF en Drive, récupérer la clé
    document.getElementById("progressZone").style.display = "block";
    setProgress(10, "Stockage du PDF en Drive...");

    google.script.run
      .withSuccessHandler(function(key) {
        // Clé stockée dans le champ caché — garantit la persistance
        setTempPdfKey(key);
        console.log("✅ tempPdfKey reçue : " + key);

        // Débloquer le bouton Valider
        document.getElementById("btnSubmit").disabled = false;
        document.getElementById("btnSubmit").textContent = "✅ Valider et créer le devis";
        document.getElementById("btnExtract").disabled = false;

        // Étape 2 : lancer l'extraction OCR
        extraireInfosAvecBase64(base64);
      })
      .withFailureHandler(function(err) {
        setProgress(0, "Erreur stockage PDF : " + err.message);
        document.getElementById("btnSubmit").disabled = false;
        document.getElementById("btnSubmit").textContent = "✅ Valider et créer le devis";
        alert("Erreur stockage PDF : " + err.message);
      })
      .stockerPDFTemporaire(base64);
  };
  reader.readAsDataURL(file);
}

function setProgress(pct, text) {
  document.getElementById("progressBar").style.width = pct + "%";
  document.getElementById("progressText").textContent = text;
}

function extraireInfosAvecBase64(base64) {
  const btn = document.getElementById("btnExtract");
  btn.disabled = true;
  btn.textContent = "Extraction en cours...";
  document.getElementById("progressZone").style.display = "block";
  setProgress(30, "Analyse du PDF par l'IA...");

  const key = getTempPdfKey();
  console.log("extraireInfos — tempPdfKey = '" + key + "'");

  google.script.run
    .withSuccessHandler(function(data) {
      setProgress(100, "Informations extraites !");
      if (data.ok && data.infos) {
        fillForm(data.infos);
        setTimeout(() => {
          document.getElementById("progressZone").style.display = "none";
          document.getElementById("stepForm").style.display = "block";
          document.getElementById("formSection").style.display = "block";
          document.getElementById("stepForm").scrollIntoView({ behavior: "smooth" });
          btn.textContent = "✅ Extraction terminée";
        }, 600);
      } else {
        setProgress(0, "Extraction impossible — " + (data.error || "réponse vide") + " — remplissez manuellement.");
        console.error("extraireInfosPDF :", data.error);
        document.getElementById("stepForm").style.display = "block";
        document.getElementById("formSection").style.display = "block";
        btn.disabled = false;
        btn.textContent = "Réessayer";
      }
    })
    .withFailureHandler(function(err) {
      setProgress(0, "Erreur extraction : " + err.message);
      btn.disabled = false;
      btn.textContent = "Réessayer";
    })
    .extraireInfosPDFDepuisPage(base64, key);
}

function fillForm(infos) {
  const map = {
    f_raisonSociale: infos.raisonSociale, f_formeJuridique: infos.formeJuridique,
    f_siret: infos.siret, f_adresse: infos.adresse, f_codePostal: infos.codePostal,
    f_ville: infos.ville, f_telephone: infos.telephone, f_emailOrga: infos.emailOrga,
    f_signataire: infos.signataire, f_qualite: infos.qualite, f_nomProjet: infos.nomProjet,
    f_dateDebut: infos.dateDebut, f_dateFin: infos.dateFin,
    f_nbRepresen: infos.nbRepresen || "", f_heures: infos.heures || "",
    f_tarifHeure: infos.tarifHeure || "", f_prixCession: infos.prixCession || "",
    f_fraisHeberg: infos.fraisHeberg || "", f_fraisResto: infos.fraisResto || "",
    f_fraisDeplac: infos.fraisDeplac || "",
  };
  for (const [id, val] of Object.entries(map)) {
    const el = document.getElementById(id);
    if (el && val !== null && val !== undefined) el.value = val;
  }
  if (infos.typeSpectacle) {
    const sel = document.getElementById("f_typeSpectacle");
    for (let i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value === infos.typeSpectacle) { sel.selectedIndex = i; break; }
    }
  }
}

function soumettre() {
  const key = getTempPdfKey();
  console.log("soumettre — tempPdfKey = '" + key + "'");
  if (!key) {
    alert("Le PDF n'a pas encore été stocké. Veuillez patienter ou re-uploader le fichier.");
    return;
  }
  const btn = document.getElementById("btnSubmit");
  btn.disabled = true;
  btn.textContent = "Envoi en cours...";

  const payload = {
    tempPdfKey: key,
    raisonSociale:  document.getElementById("f_raisonSociale").value,
    formeJuridique: document.getElementById("f_formeJuridique").value,
    siret:          document.getElementById("f_siret").value,
    adresse:        document.getElementById("f_adresse").value,
    codePostal:     document.getElementById("f_codePostal").value,
    ville:          document.getElementById("f_ville").value,
    telephone:      document.getElementById("f_telephone").value,
    emailOrga:      document.getElementById("f_emailOrga").value,
    signataire:     document.getElementById("f_signataire").value,
    qualite:        document.getElementById("f_qualite").value,
    nomProjet:      document.getElementById("f_nomProjet").value,
    dateDebut:      document.getElementById("f_dateDebut").value,
    dateFin:        document.getElementById("f_dateFin").value,
    typeSpectacle:  document.getElementById("f_typeSpectacle").value,
    nbRepresen:     document.getElementById("f_nbRepresen").value,
    heures:         document.getElementById("f_heures").value,
    tarifHeure:     document.getElementById("f_tarifHeure").value,
    prixCession:    document.getElementById("f_prixCession").value,
    fraisHeberg:    document.getElementById("f_fraisHeberg").value,
    fraisResto:     document.getElementById("f_fraisResto").value,
    fraisDeplac:    document.getElementById("f_fraisDeplac").value,
    fraisMediation: document.getElementById("f_fraisMediation").value,
    rediger:        document.getElementById("f_rediger").value,
  };

  google.script.run
    .withSuccessHandler(function(data) {
      if (data.ok) {
        document.getElementById("mainZone").style.display    = "none";
        document.getElementById("successZone").style.display = "block";
      } else {
        alert("Erreur : " + (data.error || "inconnue"));
        btn.disabled = false;
        btn.textContent = "✅ Valider et créer le devis";
      }
    })
    .withFailureHandler(function(err) {
      alert("Erreur : " + err.message);
      btn.disabled = false;
      btn.textContent = "✅ Valider et créer le devis";
    })
    .soumettreFormulaireDepuisPage(payload);
}
</script>
</body></html>`;

  return HtmlService.createHtmlOutput(html)
    .setTitle("Nouveau devis — AMIIS")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ============================================================
//  STOCKER LE PDF TEMPORAIREMENT EN DRIVE
//  Retourne une clé string pour retrouver le fichier ensuite
// ============================================================

function stockerPDFTemporaire(base64) {
  try {
    const pdfBytes = Utilities.base64Decode(base64);
    const pdfBlob  = Utilities.newBlob(pdfBytes, "application/pdf", "_tmp_devis.pdf");
    const tmpFile  = DriveApp.getFolderById(CONFIG.DRIVE_FOLDER_ID).createFile(pdfBlob);
    const key      = "PDF_TMP_" + Utilities.getUuid();
    PropertiesService.getScriptProperties().setProperty(key, tmpFile.getId());
    Logger.log("📦 PDF temporaire stocké : " + tmpFile.getId() + " | clé : " + key);
    return key;
  } catch (err) {
    Logger.log("❌ stockerPDFTemporaire : " + err.message);
    throw err;
  }
}

// ============================================================
//  EXTRACTION PDF VIA OCR DRIVE + GROQ
//  Accepte soit un base64 (premier appel), soit une clé tempPdfKey
// ============================================================

function extraireInfosPDFDepuisPage(base64, tempPdfKey) {
  const result = extraireInfosPDF(base64, tempPdfKey);
  return JSON.parse(result.getContent());
}

function extraireInfosPDF(base64, tempPdfKey) {
  try {
    Logger.log("extraireInfosPDF — extraction texte via OCR Drive");

    // ── Récupérer le blob PDF ─────────────────────────────────
    // On préfère récupérer le fichier déjà stocké en Drive (via tempPdfKey)
    // pour éviter de re-transmettre le base64. Fallback sur le base64 direct.
    let pdfBlob = null;

    if (tempPdfKey) {
      const fileId = PropertiesService.getScriptProperties().getProperty(tempPdfKey);
      if (fileId) {
        try {
          pdfBlob = DriveApp.getFileById(fileId).getBlob().copyBlob();
          pdfBlob.setName("_tmp_ocr_input.pdf");
          Logger.log("Blob récupéré depuis Drive fileId=" + fileId);
        } catch (e) {
          Logger.log("⚠️ Impossible de lire le fichier Drive : " + e.message);
        }
      }
    }

    if (!pdfBlob && base64) {
      pdfBlob = Utilities.newBlob(Utilities.base64Decode(base64), "application/pdf", "_tmp_ocr_input.pdf");
      Logger.log("Blob construit depuis base64 (" + base64.length + " chars)");
    }

    if (!pdfBlob) throw new Error("Aucun PDF disponible pour l'extraction.");

    // ── Upload en Google Doc via DriveApp (OCR natif) ─────────
    // DriveApp.createFile() avec conversion vers Google Doc déclenche l'OCR.
    const oauthToken = ScriptApp.getOAuthToken();

    // Créer le fichier PDF temporaire dans Drive
    const tmpPdfFile = DriveApp.getFolderById(CONFIG.DRIVE_FOLDER_ID).createFile(pdfBlob);
    const tmpPdfId   = tmpPdfFile.getId();
    Logger.log("PDF temporaire créé pour OCR : " + tmpPdfId);

    // Copier en Google Doc (déclenche la conversion OCR)
    const copyResp = UrlFetchApp.fetch(
      "https://www.googleapis.com/drive/v3/files/" + tmpPdfId + "/copy",
      {
        method: "POST",
        headers: {
          "Authorization": "Bearer " + oauthToken,
          "Content-Type": "application/json",
        },
        payload: JSON.stringify({
          name: "_tmp_ocr_doc",
          mimeType: "application/vnd.google-apps.document",
        }),
        muteHttpExceptions: true,
      }
    );

    // Supprimer le PDF temporaire immédiatement
    tmpPdfFile.setTrashed(true);

    const copyCode = copyResp.getResponseCode();
    Logger.log("Copy/OCR réponse [" + copyCode + "] : " + copyResp.getContentText().substring(0, 200));
    if (copyCode !== 200) throw new Error("Conversion OCR échouée [" + copyCode + "] : " + copyResp.getContentText().substring(0, 300));

    const tmpDocId = JSON.parse(copyResp.getContentText()).id;
    Utilities.sleep(3000); // Laisser le temps à l'OCR de se terminer

    // Exporter le Doc en texte brut
    const exportResp = UrlFetchApp.fetch(
      "https://www.googleapis.com/drive/v3/files/" + tmpDocId + "/export?mimeType=text/plain",
      { headers: { "Authorization": "Bearer " + oauthToken }, muteHttpExceptions: true }
    );
    const pdfText = exportResp.getContentText("UTF-8");

    // Supprimer le Doc temporaire
    UrlFetchApp.fetch("https://www.googleapis.com/drive/v3/files/" + tmpDocId, {
      method: "DELETE", headers: { "Authorization": "Bearer " + oauthToken }, muteHttpExceptions: true,
    });

    if (!pdfText || pdfText.trim().length < 20) throw new Error("PDF vide ou non lisible (PDF scanné sans OCR ?).");
    Logger.log("Texte OCR extrait (" + pdfText.length + " chars) : " + pdfText.substring(0, 300));

    // Appel Groq
    const prompt = `Voici le texte extrait d'un devis de spectacle vivant.
Ce document contient deux parties : le PRODUCTEUR (Collectif Les Ruminantes / AMIIS) et l'ORGANISATEUR (le client).
Extrait UNIQUEMENT les informations de l'ORGANISATEUR.
Retourne UNIQUEMENT un JSON valide sans markdown, sans backticks. Format exact :
{"raisonSociale":"","formeJuridique":"","siret":"","adresse":"","codePostal":"","ville":"","telephone":"","emailOrga":"","signataire":"","qualite":"","nomProjet":"","dateDebut":"YYYY-MM-DD","dateFin":"YYYY-MM-DD","typeSpectacle":"","nbRepresen":0,"heures":0,"tarifHeure":0,"prixCession":0,"fraisHeberg":0,"fraisResto":0,"fraisDeplac":0,"fraisMediation":0}
Si une info est absente : "" ou 0. Pour typeSpectacle : "Spectacle", "Médiation" ou "Spectacle + Médiation".
TEXTE : ${pdfText}`;

    if (!CONFIG.GROQ_API_KEY) throw new Error("Clé Groq absente : ajoutez GROQ_API_KEY dans Paramètres du projet → Propriétés du script.");

    const groqResp = UrlFetchApp.fetch("https://api.groq.com/openai/v1/chat/completions", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": "Bearer " + CONFIG.GROQ_API_KEY },
      payload: JSON.stringify({
        model: "llama-3.3-70b-versatile",
        messages: [
          { role: "system", content: "Tu réponds UNIQUEMENT avec un objet JSON valide, sans texte avant ni après." },
          { role: "user",   content: prompt },
        ],
        temperature: 0,
        max_tokens: 1500,
        response_format: { type: "json_object" },
      }),
      muteHttpExceptions: true,
    });

    const groqCode = groqResp.getResponseCode();
    if (groqCode === 401) throw new Error("Clé Groq invalide ou révoquée : créez-en une nouvelle sur console.groq.com/keys et mettez-la dans la propriété du script GROQ_API_KEY.");
    if (groqCode !== 200) throw new Error("Groq erreur [" + groqCode + "] : " + groqResp.getContentText().substring(0, 200));

    const groqResult = JSON.parse(groqResp.getContentText());
    const rawText    = groqResult.choices[0].message.content.trim().replace(/```json|```/g, "").trim();
    const infos      = JSON.parse(rawText);
    Logger.log("✅ Extraction OK : " + JSON.stringify(infos).substring(0, 200));

    return jsonResponse({ ok: true, infos });

  } catch (err) {
    Logger.log("❌ extraireInfosPDF : " + err.message);
    return jsonResponse({ ok: false, error: err.message });
  }
}

// ============================================================
//  TRAITEMENT DU FORMULAIRE DE SAISIE (appelé depuis HTML)
// ============================================================

function soumettreFormulaireDepuisPage(params) {
  const result = traiterFormulaireSaisie(params);
  return JSON.parse(result.getContent());
}

function traiterFormulaireSaisie(params) {
  try {
    Logger.log("traiterFormulaireSaisie démarré");
    const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    const sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
    if (!sheet) throw new Error("Feuille " + CONFIG.SHEET_NAME + " introuvable.");

    const lastRow = sheet.getLastRow() + 1;
    Logger.log("Écriture ligne " + lastRow);

    // Timestamp col A
    sheet.getRange(lastRow, 1).setValue(new Date());

    // ── PDF du devis organisateur en colonne D ──────────────────
    if (params.tempPdfKey) {
      try {
        const fileId = PropertiesService.getScriptProperties().getProperty(params.tempPdfKey);
        if (fileId) {
          const tmpFile   = DriveApp.getFileById(fileId);
          const annee     = new Date().getFullYear().toString();
          const dossierAnnee = getDossierAnnee(annee);

          tmpFile.setName("Devis_" + (params.nomProjet || "document") + ".pdf");
          tmpFile.moveTo(dossierAnnee);
          tmpFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

          const richText = SpreadsheetApp.newRichTextValue()
            .setText("📎 Devis " + (params.nomProjet || ""))
            .setLinkUrl(tmpFile.getUrl())
            .build();
          sheet.getRange(lastRow, CONFIG.COL_PDF_DEVIS).setRichTextValue(richText);
          SpreadsheetApp.flush();

          PropertiesService.getScriptProperties().deleteProperty(params.tempPdfKey);
          Logger.log("📎 PDF devis écrit en col D ligne " + lastRow + " : " + tmpFile.getUrl());
        }
      } catch (pdfErr) {
        Logger.log("⚠️ Erreur lien PDF devis : " + pdfErr.message);
      }
    }
    // ── Données projet colonnes E(5) à Q(17) ───────────────────
    sheet.getRange(lastRow,  5).setValue(params.nomProjet      || "");
    sheet.getRange(lastRow,  6).setValue(params.dateDebut      || "");
    sheet.getRange(lastRow,  7).setValue(params.dateFin        || "");
    sheet.getRange(lastRow,  8).setValue(params.typeSpectacle  || "");
    sheet.getRange(lastRow,  9).setValue(parseFloat(params.heures)         || 0);
    sheet.getRange(lastRow, 10).setValue(parseFloat(params.tarifHeure)     || 0);
    sheet.getRange(lastRow, 11).setValue("");  // médiation liée
    sheet.getRange(lastRow, 12).setValue(parseFloat(params.nbRepresen)     || 0);
    sheet.getRange(lastRow, 13).setValue(parseFloat(params.prixCession)    || 0);
    sheet.getRange(lastRow, 14).setValue(parseFloat(params.fraisHeberg)    || 0);
    sheet.getRange(lastRow, 15).setValue(parseFloat(params.fraisResto)     || 0);
    sheet.getRange(lastRow, 16).setValue(parseFloat(params.fraisDeplac)    || 0);
    sheet.getRange(lastRow, 17).setValue(parseFloat(params.fraisMediation) || 0);

    // Col S(19) — contrat de cession
    sheet.getRange(lastRow, 19).setValue(params.rediger || "Non");

    // Infos organisateur col T(20) à AC(29)
    sheet.getRange(lastRow, 20).setValue(params.raisonSociale  || "");
    sheet.getRange(lastRow, 21).setValue(params.siret          || "");
    sheet.getRange(lastRow, 22).setValue(params.formeJuridique || "");
    sheet.getRange(lastRow, 23).setValue(params.adresse        || "");
    sheet.getRange(lastRow, 24).setValue(params.codePostal     || "");
    sheet.getRange(lastRow, 25).setValue(params.ville          || "");
    sheet.getRange(lastRow, 26).setValue(params.telephone      || "");
    sheet.getRange(lastRow, 27).setValue(params.signataire     || "");
    sheet.getRange(lastRow, 28).setValue(params.qualite        || "");
    sheet.getRange(lastRow, 29).setValue(params.emailOrga      || "");

    SpreadsheetApp.flush();

    // Déclencher le traitement principal
    onFormSubmit({ range: sheet.getRange(lastRow, 1) });

    Logger.log("✅ Formulaire traité ligne " + lastRow);
    return jsonResponse({ ok: true });

  } catch (err) {
    Logger.log("❌ traiterFormulaireSaisie : " + err.message);
    return jsonResponse({ ok: false, error: err.message });
  }
}

/** Retourne (ou crée) le sous-dossier de l'année dans le dossier principal. */
function getDossierAnnee(annee) {
  const racine = DriveApp.getFolderById(CONFIG.DRIVE_FOLDER_ID);
  const iter   = racine.getFoldersByName(annee);
  return iter.hasNext() ? iter.next() : racine.createFolder(annee);
}

// ============================================================
//  RAPPELS AUTOMATIQUES
// ============================================================

function envoyerRappels() {
  const props    = PropertiesService.getScriptProperties().getProperties();
  const now      = new Date().getTime();
  const ss       = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  let nbRappels  = 0;

  for (const key in props) {
    if (!key.startsWith("TOKEN_")) continue;
    try {
      const data           = JSON.parse(props[key]);
      const dernierRappel  = data.dernierRappel || data.createdAt || 0;
      if ((now - dernierRappel) / (1000 * 60 * 60 * 24) < 21) continue;

      const sheetCompta = ss.getSheetByName("CODE COMPTA");
      if (!sheetCompta) continue;

      const normaliser = s => String(s).trim().toLowerCase().replace(/\s+/g, " ");
      const colM       = sheetCompta.getRange("M:M").getValues();
      let porteurMail  = null, porteurPrenom = null;
      for (let i = 0; i < colM.length; i++) {
        if (normaliser(colM[i][0]) === normaliser(data.nomProjet)) {
          porteurPrenom = sheetCompta.getRange(i + 1, 20).getValue();
          porteurMail   = sheetCompta.getRange(i + 1, 21).getValue();
          break;
        }
      }
      if (!porteurMail) continue;

      const token  = key.replace("TOKEN_", "");
      const webUrl = CONFIG.WEBAPP_URL + "?token=" + token;

      MailApp.sendEmail({
        to:      porteurMail,
        subject: "[RAPPEL] Répartition salariale en attente — " + data.nomProjet + " (" + data.reference + ")",
        body:
`Bonjour ${porteurPrenom},

Une déclaration de répartition salariale est en attente pour le projet : ${data.nomProjet}.
Référence : ${data.reference}

Formulaire : ${webUrl}

Cordialement,
L'équipe administrative`,
      });

      data.dernierRappel = now;
      PropertiesService.getScriptProperties().setProperty(key, JSON.stringify(data));
      nbRappels++;
      Logger.log("📧 Rappel envoyé à " + porteurMail);

    } catch (err) {
      Logger.log("❌ Rappel " + key + " : " + err.message);
    }
  }
  Logger.log("✅ " + nbRappels + " rappel(s) envoyé(s)");
}

// ============================================================
//  INSTALLATION DES DÉCLENCHEURS
// ============================================================

function installTriggerRappel() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === "envoyerRappels") ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger("envoyerRappels")
    .timeBased().everyWeeks(1).onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(9).create();
  Logger.log("✅ Déclencheur rappels installé (lundi 9h)");
}

function installTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === "onFormSubmit") ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger("onFormSubmit")
    .forSpreadsheet(SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID))
    .onFormSubmit().create();
  SpreadsheetApp.getUi().alert("✅ Déclencheur onFormSubmit installé !");
}
