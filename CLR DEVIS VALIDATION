// ============================================================

/** Convertit du HTML en PDF via l'API Drive (upload → export → delete). */
function htmlToPDF(htmlContent, fileName) {
  const oauthToken = ScriptApp.getOAuthToken();
  const boundary   = "-------314159265358979323846";
  const delimiter  = "\r\n--" + boundary + "\r\n";
  const closeDelim = "\r\n--" + boundary + "--";
  const meta       = JSON.stringify({ name: "_tmp_" + fileName, mimeType: "application/vnd.google-apps.document" });

  const body = delimiter + "Content-Type: application/json\r\n\r\n" + meta
             + delimiter + "Content-Type: text/html\r\n\r\n" + htmlContent
             + closeDelim;

  const uploadResp = UrlFetchApp.fetch(
    "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart",
    { method: "POST", headers: { "Authorization": "Bearer " + oauthToken, "Content-Type": "multipart/related; boundary=" + boundary }, payload: body, muteHttpExceptions: true }
  );
  const tmpId = JSON.parse(uploadResp.getContentText()).id;

  const exportResp = UrlFetchApp.fetch(
    "https://www.googleapis.com/drive/v3/files/" + tmpId + "/export?mimeType=application/pdf",
    { headers: { "Authorization": "Bearer " + oauthToken }, muteHttpExceptions: true }
  );
  const blob = exportResp.getBlob();
  blob.setName(fileName + ".pdf");

  UrlFetchApp.fetch("https://www.googleapis.com/drive/v3/files/" + tmpId, {
    method: "DELETE", headers: { "Authorization": "Bearer " + oauthToken }, muteHttpExceptions: true,
  });

  return blob;
}

/** Sauvegarde un blob dans un sous-dossier année du dossier principal. */
function sauvegarderFichierDrive(blob, sousDossier) {
  const racine       = DriveApp.getFolderById(CONFIG.DRIVE_FOLDER_ID);
  const iter         = racine.getFoldersByName(sousDossier);
  const dossierAnnee = iter.hasNext() ? iter.next() : racine.createFolder(sousDossier);
  return dossierAnnee.createFile(blob);
}

