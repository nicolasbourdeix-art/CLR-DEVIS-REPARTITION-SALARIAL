const BUDGET_NET     = ${totalNet};
const BUDGET_SEUIL   = ${BUDGET_SEUIL};
const FRAIS_HEBERG   = ${heberg};
const FRAIS_RESTO    = ${resto};
const FRAIS_DEPLAC   = ${deplac};
const TOKEN          = "${token}";
const WEBAPP         = "${CONFIG.WEBAPP_URL}";

function fmt(n){ return n.toFixed(2).replace(".",",") + " €"; }

function calculer() {
  const c = +document.getElementById("cachets").value    || 0;
  const s = +document.getElementById("services").value   || 0;
  const t = +document.getElementById("technicien").value || 0;
  const mc = c * 235.83, ms = s * 80, mt = t * 235.83;
  const total = mc + ms + mt;
  const reste = BUDGET_NET - total;
  const pct   = BUDGET_NET > 0 ? Math.min(total / BUDGET_NET * 100, 100) : 0;

  document.getElementById("rCachets").textContent    = fmt(mc);
  document.getElementById("rServices").textContent   = fmt(ms);
  document.getElementById("rTechnicien").textContent = fmt(mt);
  document.getElementById("rTotal").textContent      = fmt(total);
  document.getElementById("rReste").textContent      = fmt(reste);
  document.getElementById("barPct").textContent      = Math.round(pct) + "%";

  const bar = document.getElementById("barFill");
  bar.style.width      = pct + "%";
  bar.style.background = total > BUDGET_NET ? "#ef4444" : pct > 80 ? "#f59e0b" : "#22c55e";

  const alerte = document.getElementById("alerte");
  if (total > BUDGET_NET) {
    alerte.className = "alerte over";
    alerte.textContent = "⚠️ Budget net dépassé de " + fmt(total - BUDGET_NET);
  } else {
    alerte.className = "alerte ok";
    alerte.textContent = "✅ Budget respecté — reste " + fmt(reste);
  }

  const alerteCession = document.getElementById("alerteCession");
  if (BUDGET_SEUIL > 0 && total > BUDGET_SEUIL) {
    let restImpact = total - BUDGET_SEUIL, details = [];
    for (const f of [{nom:"frais de déplacement",val:FRAIS_DEPLAC},{nom:"frais d'hébergement",val:FRAIS_HEBERG},{nom:"frais de restauration",val:FRAIS_RESTO}]) {
      if (restImpact <= 0) break;
      if (f.val > 0) { details.push(f.nom + " (" + fmt(Math.min(restImpact, f.val)) + ")"); restImpact -= f.val; }
    }
    alerteCession.style.display = "block";
    alerteCession.className = "alerte over";
    alerteCession.textContent = "⚠️ Dépasse le prix de cession de " + fmt(total - BUDGET_SEUIL) + (details.length ? " → " + details.join(", ") : "");
  } else if (BUDGET_SEUIL > 0) {
    alerteCession.style.display = "block";
    alerteCession.className = "alerte ok";
    alerteCession.textContent = "✅ Dans le prix de cession — reste " + fmt(BUDGET_SEUIL - total);
  } else {
    alerteCession.style.display = "none";
  }
}

function envoyer() {
  const c = document.getElementById("cachets").value;
  const s = document.getElementById("services").value;
  const t = document.getElementById("technicien").value;
  const btn = document.getElementById("btnEnvoyer");
  btn.disabled = true;
  btn.textContent = "Envoi en cours...";
  fetch(WEBAPP, {
    method: "POST",
    headers: {"Content-Type":"application/x-www-form-urlencoded"},
    body: "token=" + encodeURIComponent(TOKEN) + "&cachets=" + c + "&services=" + s + "&technicien=" + t
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      document.getElementById("formZone").style.display    = "none";
      document.getElementById("successZone").style.display = "block";
    } else {
      alert("Erreur : " + (data.error || "inconnue"));
      btn.disabled = false;
      btn.textContent = "Valider la répartition";
    }
  })
  .catch(() => {
    alert("Erreur réseau, veuillez réessayer.");
    btn.disabled = false;
    btn.textContent = "Valider la répartition";
  });
}
</script>
</body></html>`;
}

