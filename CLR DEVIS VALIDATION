function retraiterLigne() {
  const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.SHEET_NAME) || ss.getActiveSheet();
  const colE  = sheet.getRange("E:E").getValues();
  let row = 2;
  for (let i = colE.length - 1; i >= 1; i--) {
    if (colE[i][0] && String(colE[i][0]).trim() !== "") { row = i + 1; break; }
  }
  if (row < 2 || row > sheet.getLastRow()) {
    SpreadsheetApp.getUi().alert("❌ Aucune ligne valide trouvée.");
    return;
  }
  const nomProjet = sheet.getRange(row, CONFIG.COL_DATA_START).getValue();
  if (!nomProjet) { SpreadsheetApp.getUi().alert("❌ Pas de données ligne " + row); return; }

  const confirm = SpreadsheetApp.getUi().alert(
    "Retraiter la ligne " + row + " ?",
    "Projet : \"" + nomProjet + "\"",
    SpreadsheetApp.getUi().ButtonSet.OK_CANCEL
  );
  if (confirm !== SpreadsheetApp.getUi().Button.OK) return;

  onFormSubmit({ range: sheet.getRange(row, 1) });
  SpreadsheetApp.getUi().alert("✅ Ligne " + row + " retraitée !");
}

// ============================================================
//  GÉNÉRATION DE RÉFÉRENCE
// ============================================================

function generateReference(sheet, currentRow) {
  let maxNum = 0;
  for (let r = 2; r <= sheet.getLastRow(); r++) {
    if (r === currentRow) continue;
    const cell = String(sheet.getRange(r, CONFIG.COL_REFERENCE).getValue() || "");
    const num  = parseInt(cell.replace(/[^0-9]/g, "").slice(-CONFIG.PADDING), 10);
    if (!isNaN(num) && num > maxNum) maxNum = num;
  }
  const nextNum = String(maxNum + 1).padStart(CONFIG.PADDING, "0");
  const year    = CONFIG.USE_YEAR ? new Date().getFullYear() : null;
  return [CONFIG.PREFIX, year, nextNum].filter(Boolean).join("-");
}

// ============================================================
//  LECTURE DES DONNÉES DE LA LIGNE
// ============================================================

function getRowData(sheet, row) {
  const numCols   = CONFIG.COL_DATA_END - CONFIG.COL_DATA_START + 1;
  const values    = sheet.getRange(row, CONFIG.COL_DATA_START, 1, numCols).getValues()[0];
  const timestamp = sheet.getRange(row, 1).getValue();

  return {
    timestamp: timestamp
      ? Utilities.formatDate(new Date(timestamp), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm")
      : "",
    fields: values.map((val, i) => {
      let formatted = "";
      if (val instanceof Date)                   formatted = Utilities.formatDate(val, Session.getScriptTimeZone(), "dd/MM/yyyy");
      else if (val !== undefined && val !== null) formatted = String(val);
      return { label: CONFIG.FIELD_LABELS[i] || "Champ " + (i + 1), value: formatted };
    }),
  };
}

// ============================================================
//  CRÉATION DU PDF RÉCAP DPAE
// ============================================================

function createDevisPDF(reference, rowData) {
  const heures      = parseFloat(rowData.fields[4].value)  || 0;
  const tarifHeure  = parseFloat(rowData.fields[5].value)  || 0;
  const nbRepresen  = parseFloat(rowData.fields[7].value)  || 0;
  const prixCession = parseFloat(rowData.fields[8].value)  || 0;
  const fraisHeberg = parseFloat(rowData.fields[9].value)  || 0;
  const fraisResto  = parseFloat(rowData.fields[10].value) || 0;
  const fraisDeplac = parseFloat(rowData.fields[11].value) || 0;
  const fraisMediation = parseFloat(rowData.fields[12] ? rowData.fields[12].value : 0) || 0;

  const honoraires = heures * tarifHeure;
  const sousTotal  = honoraires + prixCession + fraisHeberg + fraisResto + fraisDeplac + fraisMediation;
  const margeFixe  = 58 * nbRepresen;
  const posteAdm   = 85;
  const posteDiff  = 85;
  const totalFrais = margeFixe + posteAdm + posteDiff;
  const totalNet   = sousTotal - totalFrais;

  const total = sousTotal > 0 ? {
    brut: sousTotal, frais: totalFrais, net: totalNet,
    honoraires, heures, tarifHeure,
    cession: prixCession, heberg: fraisHeberg, resto: fraisResto,
    deplac: fraisDeplac, mediation: fraisMediation,
    margeFixe, posteAdm, posteDiff, nbRepresen,
  } : null;

  const htmlContent = buildDevisHTML(reference, rowData, total);
  const pdfBlob     = htmlToPDF(htmlContent, "Devis_" + reference);

  const pdfFile = sauvegarderFichierDrive(pdfBlob, new Date().getFullYear().toString());
  pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  return {
    url:        pdfFile.getUrl(),
    blob:       pdfBlob,
    totalNet:   total ? total.net        : 0,
    cession:    total ? total.cession    : 0,
    heberg:     total ? total.heberg     : 0,
    resto:      total ? total.resto      : 0,
    deplac:     total ? total.deplac     : 0,
    margeFixe:  total ? total.margeFixe  : 0,
    posteAdm:   total ? total.posteAdm   : 0,
    posteDiff:  total ? total.posteDiff  : 0,
    nbRepresen: total ? total.nbRepresen : 0,
    honoraires: total ? total.honoraires : 0,
    heures:     total ? total.heures     : 0,
    tarifHeure: total ? total.tarifHeure : 0,
  };
}

