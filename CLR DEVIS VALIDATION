//  WEB APP — doGet
// ============================================================

function doGet(e) {
  // Page de saisie manuelle
  if (e.parameter.page === "saisie") return afficherPageSaisie();

  // Page de validation de contrat
  if (e.parameter.contrat) return afficherContratValidation(e.parameter.contrat);

  // URL nue (sans token) : ouvrir la page de saisie plutôt que « lien expiré »
  if (!e.parameter.token) return afficherPageSaisie();

  // Page de répartition salariale
  const token   = e.parameter.token || "";
  const propVal = PropertiesService.getScriptProperties().getProperty("TOKEN_" + token);

  if (!propVal) {
    return HtmlService.createHtmlOutput(
      `<html><body style="font-family:Arial;text-align:center;padding:60px;">
        <h2 style="color:#991b1b;">⚠️ Ce lien est expiré ou invalide.</h2>
        <p style="color:#6b7280;margin-top:12px;">La répartition a déjà été saisie ou le lien n'est plus actif.</p>
      </body></html>`
    ).setTitle("Lien expiré");
  }

  const { nomProjet, reference, totalNet, detail } = JSON.parse(propVal);
  return HtmlService.createHtmlOutput(
    buildRepartitionHTML(token, nomProjet, reference, totalNet, detail || {})
  ).setTitle("Répartition salariale — " + nomProjet)
   .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ============================================================
//  WEB APP — doPost
// ============================================================

function doPost(e) {
  try {
    let params = {};
    if (e && e.postData) {
      const raw = e.postData.contents || "";
      if (e.postData.type === "application/json") {
        try { params = JSON.parse(raw); } catch(_) {}
      } else {
        try { params = JSON.parse(raw); } catch(_) {
          raw.split("&").forEach(pair => {
            const idx = pair.indexOf("=");
            if (idx > 0) {
              params[decodeURIComponent(pair.substring(0, idx))] =
                decodeURIComponent(pair.substring(idx + 1).replace(/\+/g, " "));
            }
          });
        }
      }
    }
    if (!params.action && e && e.parameter) params = e.parameter;

    Logger.log("doPost action=" + params.action + " token=" + params.token);

    if (params.action === "validerContrat") return validerEtGenererContrat(params.token);
    if (params.action === "soumettreFormulaire") return traiterFormulaireSaisie(params);
    if (params.action === "extrairePDF")         return extraireInfosPDF(params.pdfBase64);
    if (params.action === "annulerContrat") {
      PropertiesService.getScriptProperties().deleteProperty("CONTRAT_" + params.token);
      return jsonResponse({ ok: true });
    }

    // Répartition salariale (formulaire temporaire)
    const token   = params.token || "";
    const propKey = "TOKEN_" + token;
    const propVal = PropertiesService.getScriptProperties().getProperty(propKey);
    if (!propVal) return jsonResponse({ ok: false, error: "Token invalide ou expiré" });

    const { ligne, htmlFileId } = JSON.parse(propVal);
    const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    const sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
    sheet.getRange(ligne, 30).setValue(params.cachets   || 0);
    sheet.getRange(ligne, 31).setValue(params.services  || 0);
    sheet.getRange(ligne, 32).setValue(params.technicien || 0);

    if (htmlFileId) {
      try { DriveApp.getFileById(htmlFileId).setTrashed(true); } catch(_) {}
    }
    PropertiesService.getScriptProperties().deleteProperty(propKey);
    Logger.log("✅ Répartition enregistrée ligne " + ligne);
    return jsonResponse({ ok: true });

  } catch (err) {
    Logger.log("❌ doPost : " + err.message + "\n" + err.stack);
    return jsonResponse({ ok: false, error: err.message });
  }
}

function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

