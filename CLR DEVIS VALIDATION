function validerEtGenererContrat(token) {
  try {
    const propKey = "CONTRAT_" + token;
    const propVal = PropertiesService.getScriptProperties().getProperty(propKey);
    if (!propVal) return jsonResponse({ ok: false, error: "Token invalide ou déjà utilisé" });

    const d = JSON.parse(propVal);
    const lignesPrix = buildLignesPrixHTML(d);
    const logoB64    = getLogoRuminantesB64();
    const html       = buildContratPDFHTML(d, lignesPrix, logoB64);

    const pdfBlob = htmlToPDF(html, "Contrat_Cession_" + d.reference + "_" + d.nomProjet);
    const pdfFile = sauvegarderFichierDrive(pdfBlob, new Date().getFullYear().toString());
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    const pdfUrl = pdfFile.getUrl();

    // Écrire le lien en colonne AG (33)
    const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    const sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
    if (sheet && d.ligne) {
      const richText = SpreadsheetApp.newRichTextValue()
        .setText("📄 Contrat " + d.reference)
        .setLinkUrl(pdfUrl)
        .build();
      sheet.getRange(d.ligne, 33).setRichTextValue(richText);
      Logger.log("🔗 Lien contrat écrit col AG ligne " + d.ligne);
    }

    PropertiesService.getScriptProperties().deleteProperty(propKey);
    Logger.log("✅ Contrat validé : " + d.reference);
    return jsonResponse({ ok: true });

  } catch (err) {
    Logger.log("❌ validerEtGenererContrat : " + err.message);
    return jsonResponse({ ok: false, error: err.message });
  }
}

