// ============================================================
//  ENVOI DU MAIL AU PORTEUR
// ============================================================

function envoyerMailPorteur(ss, nomProjet, reference, pdfUrl, pdfBlob, ligneDevis, totalNet, detail) {
  const sheetCompta = ss.getSheetByName("CODE COMPTA");
  if (!sheetCompta) { Logger.log("⚠️ Feuille 'CODE COMPTA' introuvable."); return; }

  const colM        = sheetCompta.getRange("M:M").getValues();
  const normaliser  = s => String(s).trim().toLowerCase().replace(/\s+/g, " ");
  const nomRecherche = normaliser(nomProjet);
  let porteurPrenom = null;
  let porteurMail   = null;

  for (let i = 0; i < colM.length; i++) {
    if (normaliser(colM[i][0]) === nomRecherche) {
      porteurPrenom = sheetCompta.getRange(i + 1, 20).getValue();
      porteurMail   = sheetCompta.getRange(i + 1, 21).getValue();
      break;
    }
  }

  if (!porteurMail) {
    Logger.log("⚠️ Projet \"" + nomProjet + "\" non trouvé dans CODE COMPTA — mail non envoyé.");
    return;
  }

  const emails  = String(porteurMail).split(/[,;]/).map(e => e.trim()).filter(Boolean);
  const emailTo = emails[0];
  const emailCc = emails.slice(1).join(",");

  const formsUrl = creerFormTemporaire(ss, nomProjet, reference, pdfUrl, ligneDevis, totalNet, detail);

  const mailOptions = {
    to:      emailTo,
    subject: "Nouveau contrat validé — " + nomProjet + " (" + reference + ")",
    body:
`Bonjour ${porteurPrenom},

Un nouveau contrat a été validé pour le projet : ${nomProjet}.
Référence : ${reference}

Vous trouverez en pièce jointe la note d'information relative à ce contrat.

Merci de remplir le formulaire de répartition salariale :
${formsUrl}

⚠️ Ce formulaire est temporaire et sera supprimé après votre saisie.

Pour consulter la note DPAE à tout moment :
${pdfUrl}

Cordialement,
L'équipe administrative`,
    attachments: [pdfBlob],
  };
  if (emailCc) mailOptions.cc = emailCc;

  MailApp.sendEmail(mailOptions);
  Logger.log("📧 Mail envoyé à " + emailTo + " pour \"" + nomProjet + "\"");
}

// ============================================================
//  FORMULAIRE TEMPORAIRE DE RÉPARTITION SALARIALE
// ============================================================

function creerFormTemporaire(ss, nomProjet, reference, pdfUrl, ligneDevis, totalNet, detail) {
  const token = Utilities.getUuid();
  PropertiesService.getScriptProperties().setProperty(
    "TOKEN_" + token,
    JSON.stringify({
      ligne: ligneDevis, reference, nomProjet, totalNet, detail,
      createdAt: new Date().getTime(),
    })
  );
  const url = CONFIG.WEBAPP_URL + "?token=" + token;
  Logger.log("🌐 Page de répartition : " + url);
  return url;
}

