// ============================================================
//  RENVOYER LE CONTRAT
// ============================================================

function renvoyerContrat() {
  const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
  const ui    = SpreadsheetApp.getUi();

  const response = ui.prompt("Renvoyer le contrat", "Entrez le numéro de ligne :", ui.ButtonSet.OK_CANCEL);
  if (response.getSelectedButton() !== ui.Button.OK) return;

  const row = parseInt(response.getResponseText().trim());
  if (isNaN(row) || row < 2 || row > sheet.getLastRow()) {
    ui.alert("❌ Ligne " + row + " invalide.");
    return;
  }

  const reference = sheet.getRange(row, CONFIG.COL_REFERENCE).getValue();
  if (!reference) {
    ui.alert("❌ Pas de référence en ligne " + row + " — traitez d'abord cette ligne.");
    return;
  }

  const nomProjet = sheet.getRange(row, 5).getValue();
  const confirm   = ui.alert(
    "Renvoyer le contrat pour :\n" + nomProjet + " (" + reference + ") ?",
    ui.ButtonSet.OK_CANCEL
  );
  if (confirm !== ui.Button.OK) return;

  try {
    const rowData = getRowData(sheet, row);
    genererContratCession(ss, sheet, row, rowData, reference);
    ui.alert("✅ Mail de contrat renvoyé pour " + reference + " !");
  } catch (err) {
    ui.alert("❌ Erreur : " + err.message);
    Logger.log("❌ renvoyerContrat : " + err.message);
  }
}

// ============================================================
//  DÉCLENCHEUR PRINCIPAL onFormSubmit
// ============================================================

function onFormSubmit(e) {
  if (!e || !e.range) {
    SpreadsheetApp.getUi().alert(
      "⚠️ Ce script ne peut pas être exécuté manuellement.\n\n" +
      "Utilisez 'testerAvecDerniereLigne' pour tester."
    );
    return;
  }

  try {
    const ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    const sheet = ss.getSheetByName(CONFIG.SHEET_NAME) || ss.getActiveSheet();
    const row   = e.range.getRow();

    // 1. Générer la référence
    const reference = generateReference(sheet, row);
    sheet.getRange(row, CONFIG.COL_REFERENCE).setValue(reference);

    // 2. Lire les données
    const rowData = getRowData(sheet, row);

    // 3. Créer le PDF récap DPAE
    const pdfResult = createDevisPDF(reference, rowData);

    // 4. Écrire le lien PDF récap en colonne B
    const richText = SpreadsheetApp.newRichTextValue()
      .setText("📄 Recap Devis validé")
      .setLinkUrl(pdfResult.url)
      .build();
    sheet.getRange(row, CONFIG.COL_PDF_LINK).setRichTextValue(richText);

    // 5. Envoyer le mail au porteur
    const detail = {
      cession:    pdfResult.cession,
      heberg:     pdfResult.heberg,
      resto:      pdfResult.resto,
      deplac:     pdfResult.deplac,
      margeFixe:  pdfResult.margeFixe,
      posteAdm:   pdfResult.posteAdm,
      posteDiff:  pdfResult.posteDiff,
      nbRepresen: pdfResult.nbRepresen,
      honoraires: pdfResult.honoraires,
      heures:     pdfResult.heures,
      tarifHeure: pdfResult.tarifHeure,
      dateDebut:  rowData.fields[1].value,
      dateFin:    rowData.fields[2].value,
    };
    envoyerMailPorteur(ss, rowData.fields[0].value, reference, pdfResult.url, pdfResult.blob, row, pdfResult.totalNet, detail);

    // 6. Générer le contrat si col S (19) = "Oui"
    if (String(sheet.getRange(row, 19).getValue()).trim().toLowerCase() === "oui") {
      Utilities.sleep(3000);
      genererContratCession(ss, sheet, row, rowData, reference);
    }

    Logger.log("✅ Devis créé : " + reference + " | Ligne " + row);

  } catch (err) {
    Logger.log("❌ onFormSubmit : " + err.message + "\n" + err.stack);
  }
}

