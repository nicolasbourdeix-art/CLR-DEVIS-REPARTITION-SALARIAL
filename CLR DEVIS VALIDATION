function genererContratCession(ss, sheet, row, rowData, reference) {
  try {
    const nomProjet      = rowData.fields[0].value;
    const dateDebut      = rowData.fields[1].value;
    const dateFin        = rowData.fields[2].value;
    const nbRepresen     = rowData.fields[7].value;
    const heures         = parseFloat(rowData.fields[4].value)  || 0;
    const tarifHeure     = parseFloat(rowData.fields[5].value)  || 0;
    const honoraires     = heures * tarifHeure;
    const prixCession    = parseFloat(rowData.fields[8].value)  || 0;
    const fraisHeberg    = parseFloat(rowData.fields[9].value)  || 0;
    const fraisResto     = parseFloat(rowData.fields[10].value) || 0;
    const fraisDeplac    = parseFloat(rowData.fields[11].value) || 0;
    const fraisMediation = parseFloat(rowData.fields[12] ? rowData.fields[12].value : 0) || 0;
    const totalContrat   = honoraires + prixCession + fraisHeberg + fraisResto + fraisDeplac + fraisMediation;

    const raisonSociale  = sheet.getRange(row, 20).getValue();
    const siret          = sheet.getRange(row, 21).getValue();
    const formeJuridique = sheet.getRange(row, 22).getValue();
    const adresse        = sheet.getRange(row, 23).getValue();
    const codePostal     = sheet.getRange(row, 24).getValue();
    const ville          = sheet.getRange(row, 25).getValue();
    const telephone      = sheet.getRange(row, 26).getValue();
    const signataire     = sheet.getRange(row, 27).getValue();
    const qualite        = sheet.getRange(row, 28).getValue();
    const emailOrga      = sheet.getRange(row, 29).getValue();

    // Chercher les intervenants
    const sheetCompta = ss.getSheetByName("CODE COMPTA");
    let intervenants = "À définir";
    if (sheetCompta) {
      const colM       = sheetCompta.getRange("M:M").getValues();
      const colQ       = sheetCompta.getRange("Q:Q").getValues();
      const normaliser = s => String(s).trim().toLowerCase().replace(/\s+/g, " ");
      const lignes     = [];
      for (let i = 0; i < colM.length; i++) {
        if (normaliser(colM[i][0]) === normaliser(nomProjet) && colQ[i][0]) {
          lignes.push(String(colQ[i][0]).trim());
        }
      }
      if (lignes.length > 0) intervenants = lignes.join(", ");
    }

    const token      = Utilities.getUuid();
    const aujourdhui = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy");

    PropertiesService.getScriptProperties().setProperty(
      "CONTRAT_" + token,
      JSON.stringify({
        nomProjet, dateDebut, dateFin, nbRepresen,
        heures, tarifHeure, honoraires,
        prixCession, fraisHeberg, fraisResto, fraisDeplac, fraisMediation, totalContrat,
        raisonSociale, siret, formeJuridique, adresse, codePostal, ville,
        telephone, signataire, qualite, emailOrga, intervenants,
        aujourdhui, reference, ssId: ss.getId(), ligne: row,
      })
    );

    const pageUrl = CONFIG.WEBAPP_URL + "?contrat=" + token;

    MailApp.sendEmail({
      to:      CONFIG.DROPBOX_SIGN_EMAIL_NOTIF,
      subject: "[À VALIDER] Contrat de Cession — " + nomProjet + " (" + reference + ")",
      body:
`Bonjour,

Un nouveau contrat de cession est prêt à être validé.

Projet       : ${nomProjet}
Référence    : ${reference}
Dates        : Du ${dateDebut} au ${dateFin}
Organisateur : ${raisonSociale} — ${signataire} (${qualite})
Montant      : ${totalContrat.toFixed(2)} €

Lien de validation :
${pageUrl}

Cordialement,
Script automatique AMIIS`,
    });

    Logger.log("📄 Contrat prêt : " + pageUrl);

  } catch (err) {
    Logger.log("❌ genererContratCession : " + err.message);
  }
}

